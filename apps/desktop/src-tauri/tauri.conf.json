{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "The Machine",
  "version": "0.1.0",
  "identifier": "com.the-machine.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev -- --filter @the-machine/desktop",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build -- --filter @the-machine/desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "The Machine",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
