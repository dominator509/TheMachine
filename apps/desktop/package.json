{
  "name": "@the-machine/desktop",
  "version": "0.3.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "node scripts/build-frontend.mjs",
    "dev": "node scripts/dev-server.mjs",
