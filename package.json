{
  "name": "the-machine",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Durable local-first control plane for agentic software delivery",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.6.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:agentic": "vitest run --project integration tests/integration/agentic-runtime.integration.test.ts",
    "build": "turbo run build",
    "build:release": "node tools/release/build-release.mjs",
    "security:check": "node tools/security/check-secrets.mjs",
    "audit": "pnpm audit --audit-level high",
    "smoke": "node tools/smoke/smoke-test.mjs",
    "production:readiness": "node tools/readiness/production-readiness-check.mjs",
    "db:setup": "node tools/db/setup.mjs",
    "db:migration:create": "node tools/db/create-migration.mjs",
    "db:migrate": "node tools/db/migrate.mjs",
    "db:migrate:rollback": "node tools/db/rollback.mjs",
    "machine": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "3.2.6",
    "esbuild": "^0.28.1",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "sharp": "^0.35.1"
  }
}
